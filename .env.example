# The app uses a shared company code rather than individual employee accounts.
# Configure these as server-side environment variables (never VITE_ variables).
COMPANY_ACCESS_CODE="replace-with-a-random-code-of-at-least-12-characters"
SESSION_SECRET="replace-with-a-random-secret-of-at-least-32-characters"

# Existing PostgreSQL connection. Keep credentials server-side.
SQL_HOST=""
SQL_USER=""
SQL_PASSWORD=""
SQL_DB_NAME=""

# Required for Gemini AI calls; set only if using those features.
GEMINI_API_KEY=""
APP_URL=""
